DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scanhemat?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
MAX_RECEIPT_UPLOAD_MB="8"
OCR_PROVIDER="google-document-ai"
# Optional local/dev fallback for image receipts only.
# OCR_FALLBACK_PROVIDER="tesseract"
GOOGLE_CLOUD_PROJECT_ID="replace-with-google-cloud-project-id"
GOOGLE_CLOUD_LOCATION="us"
GOOGLE_DOCUMENT_AI_PROCESSOR_ID="replace-with-document-ai-processor-id"
AI_GENERATION_PROVIDER="gemini-api"
GEMINI_API_KEY=""
GEMINI_RECEIPT_MODEL="gemini-3.5-flash"
GEMINI_ASSISTANT_MODEL="gemini-3.5-flash"
GEMINI_VISION_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash"
# Optional fallback for generative AI only when AI_GENERATION_PROVIDER="vertex-ai".
GOOGLE_VERTEX_AI_PROJECT_ID="replace-with-vertex-project-id"
GOOGLE_VERTEX_AI_LOCATION="us-central1"
# Path to the Google Cloud service account JSON key file.
# Required for Google Document AI authentication.
# GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account-key.json"
