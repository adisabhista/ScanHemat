{
  "name": "scanhemat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "dotenv -e .env.local -- prisma generate",
