generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  accounts      Account[]
  sessions      Session[]
  categories    Category[]
  receipts      Receipt[]
  transactions  Transaction[]
  budgets       Budget[]
  reminders     Reminder[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id           String        @id @default(cuid())
  userId       String?
  name         String
  color        String?
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
  @@index([userId])
}

model Receipt {
  id           String        @id @default(cuid())
  userId       String
  fileName     String
  filePath     String
  mimeType     String
  fileSize     Int
  rawText      String?       @db.Text
  parsedData   Json?
  status       ReceiptStatus @default(UPLOADED)
  errorMessage String?
  needsReview  Boolean       @default(false)
  reviewReasons Json?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction  Transaction?

  @@index([userId, createdAt])
  @@index([userId, needsReview])
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  receiptId       String?           @unique
  categoryId      String
  merchant        String?
  transactionDate DateTime
  totalAmount     Decimal           @db.Decimal(14, 2)
  notes           String?
  source          TransactionSource @default(MANUAL)
  needsReview     Boolean           @default(false)
  reviewReason    Json?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipt         Receipt?          @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  category        Category          @relation(fields: [categoryId], references: [id])
  items           TransactionItem[]

  @@index([userId, transactionDate])
  @@index([userId, categoryId])
  @@index([userId, needsReview])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  name          String
  quantity      Decimal?    @db.Decimal(10, 2)
  unitPrice     Decimal?    @db.Decimal(14, 2)
  totalPrice    Decimal?    @db.Decimal(14, 2)
  createdAt     DateTime    @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  month      Int
  year       Int
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
}

model Reminder {
  id                  String         @id @default(cuid())
  userId              String
  title               String
  type                ReminderType
  amount              Decimal?       @db.Decimal(14, 2)
  dueDate             DateTime
  reminderOffsets     Int[]          @default([])
  repeatType          RepeatType     @default(NONE)
  status              ReminderStatus @default(ACTIVE)
  notes               String?        @db.Text
  relatedMerchant     String?
  relatedDocumentName String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([userId, type])
}

enum ReceiptStatus {
  UPLOADED
  OCR_PROCESSING
  OCR_COMPLETED
  OCR_FAILED
  CONFIRMED
}

enum TransactionSource {
  MANUAL
  RECEIPT_OCR
  PDF_OCR
}

enum ReminderType {
  SUBSCRIPTION
  BILL
  VEHICLE_TAX
  STNK
  SIM
  WARRANTY
  LICENSE
  DOCUMENT
  OTHER
}

enum RepeatType {
  NONE
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum ReminderStatus {
  ACTIVE
  DONE
  DISMISSED
  EXPIRED
}
